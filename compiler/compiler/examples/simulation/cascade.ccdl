// Topological evaluation must run z_first before a_second despite their names.
board cascade {
    input: stimulus;
    output: answer;
    node cause: ^8^C_{F2}|A;
    node bias: ^5^P_{F7}|T;
    node middle: ^9^C_{F6}|A;
    node effect: ^9^C_{F6}|A;
    cjt a_second: CJT< middle | bias => effect > [beta=0.5, sat=0.9, cutoff=0.1];
    cjt z_first: CJT< cause | bias => middle > [beta=2, sat=0.75, cutoff=0.1];
    probe observed: effect;
}
