// Scalar design simulation; values are declared activations, not measurements.
board fixed_bias {
    input: drive;
    output: response;
    node cause: ^8^C_{F2}|A;
    node bias: ^5^P_{F7}|T;
    node effect: ^9^C_{F6}|A;
    cjt stage: CJT< cause | bias => effect > [beta=2, sat=0.85, cutoff=0.1];
    probe observed: effect;
}
